  "preview_urls": false,
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SERVER",
        "script_name": "qqfile",
        "class_name": "WebSocketServer"
      }
    ]
  },
  "migrations": [
