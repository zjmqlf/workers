{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forward1",
  "main": "forward1.js",
  "vars": {
    "APP_NAME": "forward1",
    "BEGIN_INDEX": 0,
    "END_INDEX": 21
  },
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "assets": {
  //   "binding": "ASSETS",
  //   "directory": "./forward1/build"
  // },
  // "routes": [
  //   {
  //     "pattern": "forward1.19421.xyz/*",
  //     "zone_name": "19421.xyz"
  //   }
  // ],
  "preview_urls": false,
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "MAINDB",
      "database_name": "maindb",
      "database_id": "97d41e14-a9b6-45a9-b5cc-f60eb29acc02"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SERVER",
        "script_name": "forward1",
        "class_name": "WebSocketServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebSocketServer"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "placement": {
    "mode": "smart"
  }
}
