{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lockhivecode",
  "main": "lockhivecode.js",
  "vars": {
    "APP_NAME": "lockhivecode",
    "API_ID": "23791555",
    "API_HASH": "916ea0bd4a924bd09dce6e4d42a2db5d",
    "SESSION_STRING": ""
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "assets": {
  //   "binding": "ASSETS",
  //   "directory": "./bot/build"
  // },
  // "routes": [
  //   {
  //     "pattern": "lockhivecode.19422.xyz/*",
  //     "zone_name": "19422.xyz"
  //   }
  // ],
  "preview_urls": false,
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "MAINDB",
      "database_name": "maindb",
      // "database_id": "aec6fc9f-94b9-4d8f-8c27-d9e730a0f5c7"
      "database_id": "0a603387-bd38-4fa7-9938-2931ddad233a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SERVER",
        "script_name": "lockhivecode",
        "class_name": "WebSocketServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebSocketServer"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "placement": {
    "mode": "smart"
  }
}
