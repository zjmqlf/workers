{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "page",
  "compatibility_date": "2026-04-21",
  "pages_build_output_dir": "./build",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "qqfile_WebSocketServer",
        "script_name": "qqfile",
        "class_name": "WebSocketServer"
      },
      // {
      //   "name": "lockhive_WebSocketServer",
      //   "script_name": "lockhive",
      //   "class_name": "WebSocketServer"
      // },
      {
        "name": "zyxfiles_WebSocketServer",
        "script_name": "zyxfiles",
        "class_name": "WebSocketServer"
      },
      {
        "name": "steviarchiver_WebSocketServer",
        "script_name": "steviarchiver",
        "class_name": "WebSocketServer"
      },
      {
        "name": "filespanindo_WebSocketServer",
        "script_name": "filespanindo",
        "class_name": "WebSocketServer"
      },
      {
        "name": "kodexchatsind_WebSocketServer",
        "script_name": "kodexchatsind",
        "class_name": "WebSocketServer"
      },
    ]
  }
}