        "class_name": "WebSocketServer"
      },
      {
        "name": "qyg100b_WebSocketServer",
        "script_name": "qyg100b",
        "class_name": "WebSocketServer"
      },
      {
        "name": "zyxfiles_WebSocketServer",
        "script_name": "zyxfiles",
        "class_name": "WebSocketServer"
      },
      {
        "name": "kodexchatsind_WebSocketServer",
        "script_name": "kodexchatsind",
        "class_name": "WebSocketServer"
      },
      {
        "name": "betapahatitakbahagia_WebSocketServer",
        "script_name": "betapahatitakbahagia",
        "class_name": "WebSocketServer"
      },
    ]
  }
}