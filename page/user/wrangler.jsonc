{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "user",
  "compatibility_date": "2026-04-21",
  "pages_build_output_dir": "./build",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "user_WebSocketServer",
        "script_name": "user",
        "class_name": "WebSocketServer"
      },
    ]
  }
}