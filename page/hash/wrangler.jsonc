{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hash",
  "compatibility_date": "2026-04-21",
  "pages_build_output_dir": "./build",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "hash_WebSocketServer",
        "script_name": "hash",
        "class_name": "WebSocketServer"
      },
    ]
  }
}