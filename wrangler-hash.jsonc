    //   "database_name": "photo1",
    //   "database_id": "828beee3-372e-4921-8007-f1e928fe78f6"
    // }
    {
      "binding": "MAINDB",
      "database_name": "maindb",
      "database_id": "ce7e5c41-15f9-48a2-96b7-1198dca42bf7"
    },
    {
      "binding": "MEDIADB",
      "database_name": "media21",
      "database_id": "407ffcb6-660f-45c1-a304-006bbe41e65d"
    },
    {
      "binding": "PHOTODB",
      "database_name": "photo1",
      "database_id": "f58289c9-1509-47ba-84b5-00286e5d3800"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SERVER",
        "script_name": "hash",
        "class_name": "WebSocketServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebSocketServer"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "placement": {
    "mode": "smart"
  }
}
