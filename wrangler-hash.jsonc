{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hash",
  "main": "hash.js",
  "vars": {
    "APP_NAME": "hash",
    "API_ID": "1334621",
    "API_HASH": "2bc36173f487ece3052a00068be59e7b",
    "SESSION_STRING": "",
    "CLIENT_ID": 1,
    "MEDIA_DB_INDEX": 21,
    "PHOTO_DB_INDEX": 1
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "assets": {
