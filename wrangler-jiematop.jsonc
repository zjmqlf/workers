{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiematop",
  "main": "jiematop.js",
  "vars": {
    "BOT_ID": "8908766090",
    "BOT_HASH": "4697995986322785712",
  },
  "compatibility_date": "2026-04-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "assets": {
  //   "binding": "ASSETS",
  //   "directory": "./bot/build"
  // },
  // "routes": [
  //   {
  //     "pattern": "jiematop.19422.xyz/*",
  //     "zone_name": "19422.xyz"
  //   }
  // ],
  "preview_urls": false,
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_SERVER",
        "script_name": "jiematop",
        "class_name": "WebSocketServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WebSocketServer"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "placement": {
    "mode": "smart"
  }
}
